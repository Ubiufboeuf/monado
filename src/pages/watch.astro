---
import { Player } from '@/components/player/Player'
import { Recomendations } from '@/components/watch/Recomendations'
import Layout from '@/layouts/Layout.astro'

const id = Astro.url.searchParams.get('v')
if (!id) return Astro.redirect('/')
---

<Layout>
  <section class='
    h-full w-full min-h-fit desktop:tv:lg:p-4 grid gap-4
    [grid-template-areas:"p""d""s"] grid-cols-1 grid-rows-[repeat(3,auto)]
    desktop:lg:[grid-template-areas:"p_s""d_s"] desktop:lg:grid-cols-[3fr_2fr] desktop:lg:grid-rows-[auto_1fr]
    desktop:cinema:lg:[grid-template-areas:"p_p""d_s"]
  '>
    <div class='[grid-area:p] w-full cinema:max-h-[70dvh] aspect-video'>
      <Player client:only />
    </div>
    <div class='[grid-area:s] w-full'>
      <Recomendations id={id} client:idle />
    </div>
  </section>
</Layout>